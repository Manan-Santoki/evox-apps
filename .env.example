# Copy to .env (or set these in Dokploy's Environment tab). Never commit the real values.
S3_ENDPOINT=https://s3.msantoki.com
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET=public
S3_PREFIX=EvolutionX/apps
PUBLIC_BASE_URL=https://s3.msantoki.com/public
# base64 -w0 your-keystore.p12
KEYSTORE_B64=
KEYSTORE_PASSWORD=
KEYSTORE_ALIAS=evox
CHECK_INTERVAL_HOURS=6
# Optional, raises the GitHub API rate limit
GITHUB_TOKEN=
# Dashboard login for approving builds. Viewing is public.
ADMIN_USER=admin
ADMIN_PASSWORD=
# true publishes new builds without waiting for approval
AUTO_APPROVE=false
DASHBOARD_URL=https://evox.msantoki.com
# Optional: Telegram message when a build is waiting
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
